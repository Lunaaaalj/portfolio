---
import { person } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="hero">
  <div class="hero-inner">
    <div class="top">
      <nav aria-label="Sections">
        <a href="#work">Selected work</a>
        <a href="#methods">Methods</a>
        <a href="#further">Further work</a>
        <a href="#contact">Contact</a>
      </nav>
      <ThemeToggle />
    </div>
    <div class="hero-title">
      <h1 class="name"><span class="start">{person.name}</span></h1>
      <p class="role">{person.role}</p>
      <p class="affil">{person.affiliation}</p>
    </div>
    <p class="hero-cap">
      The background is a loss surface drawn by its level sets. The dark red line is basin hopping:
      gradient descent with momentum until it settles, then a restart towards the next basin, computed
      in the browser as the page is read, with its update rules written beside it. Pointing anywhere
      starts a descent from that point.
    </p>
  </div>
</header>

<style>
  .hero { position: relative; z-index: 2; }
  .hero-inner {
    position: relative;
    min-height: min(100svh, 1000px);
    display: grid; grid-template-rows: auto 1fr auto;
    padding: 0 16px 32px var(--inset);
  }

  .top {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    max-width: calc(var(--main) + var(--gap) + var(--margin));
    padding: 22px 0 0;
    font: 400 14px/1.45 var(--sans); color: var(--graphite);
  }
  .top nav { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .top a { color: var(--graphite); text-decoration: none; }
  .top a:hover { color: var(--ink); }

  .hero-title { align-self: center; padding: 64px 0; }
  .name {
    font-size: clamp(52px, 7.8vw, 112px); font-weight: 400; line-height: 1; letter-spacing: -0.02em;
    max-width: 7.4em;
  }
  .role { margin: 28px 0 0; font: italic 400 clamp(20px, 1.9vw, 26px)/1.35 var(--serif); }
  .affil { margin: 6px 0 0; font: 400 14px/1.45 var(--sans); color: var(--graphite); }
  .hero-cap { margin: 0; max-width: 54ch; font: 400 13px/1.5 var(--sans); color: var(--graphite); }

  /* The title settles in once: an already-visible default, sharpened from a slight blur */
  @media (prefers-reduced-motion: no-preference) {
    .name, .role, .affil { animation: settle 1100ms cubic-bezier(.16,1,.3,1) both; }
    .role { animation-delay: 140ms; }
    .affil { animation-delay: 240ms; }
    @keyframes settle { from { opacity: 0.5; transform: translateY(10px); filter: blur(6px); } }
  }

  @media (max-width: 1099px) {
    .top { max-width: var(--main); }
  }
  @media (max-width: 760px) {
    .hero-inner { min-height: max(620px, 92svh); }
    .hero-title { align-self: end; padding: 32px 0 28px; }
    .name { font-size: clamp(44px, 12.5vw, 64px); }
  }
  /* Phones: the four sections on one row, the theme switch on a second */
  @media (max-width: 640px) {
    .top { flex-direction: column; gap: 6px; }
    .top nav { flex-wrap: nowrap; gap: 0 16px; white-space: nowrap; }
  }
  @media (max-width: 374px) {
    .top nav { gap: 0 12px; font-size: 13px; }
  }
</style>
