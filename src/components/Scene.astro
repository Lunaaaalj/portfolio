---
// One pinned scroll scene (src/scripts/showcase/engine.ts). The track is `length` viewports
// tall; the stage stays on screen while it scrolls past. The slot holds the captions: a title
// and `.beat` paragraphs, each shown over its interval of progress (`data-at="from to"`).
// `source` says what the drawing is: computed in the browser, transcribed from the report, or
// illustrative. The readout carries live numbers; `controls` adds pause and replay.
interface Props { name: string; fig: number; title: string; source: string; length?: number; controls?: boolean }
const { name, fig, title, source, length = 3, controls = false } = Astro.props;
const id = `scene-${name}`;
---
<div class="scene wide" data-scene={name} style={`--len: ${length}`}>
  <figure class="stage" aria-labelledby={`${id}-h`}>
    <figcaption class="scene-copy">
      <p class="scene-fig">Fig. {fig}<span>{source}</span></p>
      <h2 class="scene-h" id={`${id}-h`}>{title}</h2>
      <div class="beats"><slot /></div>
    </figcaption>
    <div class="scene-art">
      <canvas aria-hidden="true"></canvas>
      <p class="scene-readout" aria-hidden="true"></p>
      {controls && (
        <div class="scene-controls">
          <button type="button" class="scene-btn" data-act="pause" aria-pressed="false">Pause</button>
          <button type="button" class="scene-btn" data-act="replay">Replay</button>
        </div>
      )}
    </div>
  </figure>
</div>

<style>
  /* Static by default (no JavaScript, reduced motion): the track is the stage's own height, every
     caption shows. `.sx-live` on the root, set by the engine, pins the stage and plays it. */
  .scene {
    position: relative;
    width: 100vw; margin-left: calc(-1 * var(--inset));
    margin-top: 0;
  }
  .stage {
    margin: 0; display: grid;
    grid-template-columns: minmax(300px, 30rem) minmax(0, 1fr);
    background: var(--plate);
    border-top: 1px solid var(--rule);
    min-height: 0;
  }
  .scene + :global(.scene) .stage { border-top-color: var(--rule); }
  :global(.sx-live) .scene { height: calc(var(--len) * 100vh); height: calc(var(--len) * 100svh); }
  :global(.sx-live) .stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }

  .scene-copy {
    padding: 72px 40px 48px var(--inset);
    display: flex; flex-direction: column; justify-content: center;
    position: relative; z-index: 1;
  }
  .scene-fig {
    margin: 0 0 14px; font: 400 13px/1.5 var(--sans); color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }
  .scene-fig span { display: block; }
  .scene-h { font-size: 40px; line-height: 1.12; letter-spacing: -0.012em; font-weight: 400; margin: 0 0 28px; max-width: 14ch; }

  .beats { display: grid; }
  .beats :global(.beat) { margin: 0 0 20px; }
  .beats :global(.beat p) { margin: 0 0 0.7em; font-size: 21px; line-height: 1.5; max-width: 32ch; }
  .beats :global(.beat .eqline) { margin: 14px 0 0; font-size: 18px; color: var(--ink); }
  .beats :global(.beat .small) { font: 400 14px/1.45 var(--sans); color: var(--graphite); max-width: 40ch; margin-top: 16px; }
  .beats :global(.beat .statement) {
    font-size: clamp(40px, 4.6vw, 72px); line-height: 1.02; letter-spacing: -0.02em; max-width: 11ch; margin: 0 0 0.3em;
  }

  :global(.sx-live) .beats :global(.beat) {
    grid-area: 1 / 1; margin: 0;
    opacity: 0; transform: translateY(14px); filter: blur(4px); visibility: hidden;
    transition: opacity 520ms cubic-bezier(.16,1,.3,1), transform 520ms cubic-bezier(.16,1,.3,1), filter 520ms cubic-bezier(.16,1,.3,1), visibility 0s 520ms;
  }
  :global(.sx-live) .beats :global(.beat.is-on) {
    opacity: 1; transform: none; filter: none; visibility: visible;
    transition: opacity 620ms cubic-bezier(.16,1,.3,1) 120ms, transform 620ms cubic-bezier(.16,1,.3,1) 120ms, filter 620ms cubic-bezier(.16,1,.3,1) 120ms, visibility 0s;
  }

  .scene-art { position: relative; min-height: 70vh; }
  :global(.sx-live) .scene-art { min-height: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scene-readout {
    position: absolute; right: 24px; top: 22px; margin: 0; white-space: pre; text-align: right;
    font: 400 13px/1.5 var(--sans); color: var(--graphite); font-variant-numeric: tabular-nums;
  }
  .scene-controls { position: absolute; right: 24px; bottom: 22px; display: flex; gap: 8px; }
  .scene-btn {
    font: 400 13px/1 var(--sans); color: var(--ink); background: var(--plate);
    border: 1px solid var(--rule); border-radius: 2px; padding: 7px 10px; cursor: pointer;
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }
  .scene-btn:hover { border-color: var(--graphite); }
  .scene-btn[aria-pressed="true"] { background: var(--ink); color: var(--plate); border-color: var(--ink); }
  html:not(.sx-live) .scene-controls { display: none; }

  @media (max-width: 899px) {
    .stage { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; }
    .scene-art { grid-row: 1; min-height: 62vh; }
    .scene-copy { grid-row: 2; padding: 14px 16px 22px; justify-content: flex-start; }
    .scene-fig { margin-bottom: 6px; font-size: 12px; }
    .scene-fig span { display: inline; }
    .scene-fig span::before { content: " · "; }
    .scene-h { font-size: 27px; margin-bottom: 10px; max-width: none; }
    .beats :global(.beat p) { font-size: 17px; max-width: 60ch; }
    .beats :global(.beat .statement) { font-size: 40px; max-width: none; }
    .beats :global(.beat .eqline) { margin-top: 6px; font-size: 14px; }
    .scene-readout { right: 16px; top: 12px; font-size: 12px; }
    .scene-controls { right: 16px; bottom: 10px; }
    :global(.sx-live) .scene-art { min-height: 0; }
  }
  @media (max-width: 899px) and (max-height: 700px) {
    .scene-h { font-size: 21px; }
    .beats :global(.beat p) { font-size: 14px; line-height: 1.45; }
  }
  @media print { .scene { display: none; } }
</style>
