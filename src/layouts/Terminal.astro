---
// Layout of the terminal-brutalism pages: the network behind the page, a glass top bar with the
// section keys, the reading column, and a statusline that reports what the network is doing.
// Keys: j/k next and previous window, 1–9 the sections in the bar, t theme, p pause the network.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/terminal.css';
import Network from '../components/Network.astro';

interface Section { id: string; label: string }
interface Props { title: string; description: string; sections: Section[]; who?: string; path?: string; home?: string; preloadMath?: boolean }
const { title, description, sections, who = 'ael', path = '~/portfolio', home = '#top', preloadMath = false } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---
<!doctype html>
<html lang="en" data-world="terminal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadMath && <link rel="preload" href="/fonts/STIXTwoMath-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {Astro.site && <meta property="og:url" content={abs(Astro.url.pathname)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Apply a stored theme before first paint, so there is no flash -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body id="top">
    <Network />

    <header class="bar">
      <a class="who" href={home}><span class="blk" aria-hidden="true"></span>{who}<span class="path"> {path}</span></a>
      <nav aria-label="Sections">
        {sections.map((s, i) => <a href={`#${s.id}`} data-key={i + 1}><b aria-hidden="true">{i + 1}</b> {s.label}</a>)}
      </nav>
      <span class="sp"></span>
      <button class="theme" type="button"><span aria-hidden="true">[t] </span><span class="theme-label">theme</span></button>
    </header>

    <slot />

    <div class="sl" aria-hidden="true">
      <span class="mode" data-sl="mode">FIRE</span>
      <span class="k" data-sl="feed"></span>
      <span data-sl="edges"></span>
      <span class="wide" data-sl="next"></span>
      <span class="sp"></span>
      <span class="wide" data-sl="nll"></span>
      <span data-sl="step"></span>
      <span class="wide" data-sl="model"></span>
    </div>

    <script>
      const root = document.documentElement;
      const mq = matchMedia('(prefers-color-scheme: light)');
      const current = () => root.dataset.theme || (mq.matches ? 'light' : 'dark');
      const btn = document.querySelector<HTMLButtonElement>('.bar .theme')!;
      const label = () => { btn.querySelector('.theme-label')!.textContent = current() === 'dark' ? 'light theme' : 'dark theme'; };
      function setTheme(next: string) {
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        label(); dispatchEvent(new Event('themechange'));
      }
      const flip = () => setTheme(current() === 'dark' ? 'light' : 'dark');
      btn.addEventListener('click', flip);
      mq.addEventListener('change', () => { label(); dispatchEvent(new Event('themechange')); });
      label();

      // j/k step through the windows; digits jump to the sections in the bar
      const wins = () => [...document.querySelectorAll<HTMLElement>('[data-feed]')];
      function go(dir: number) {
        const y = scrollY + 64, list = wins();
        const t = dir > 0 ? list.find((s) => s.offsetTop > y + 4) : [...list].reverse().find((s) => s.offsetTop < y - 4);
        if (t) scrollTo({ top: Math.max(0, t.offsetTop - 56) });
        else if (dir < 0) scrollTo({ top: 0 });
      }
      addEventListener('keydown', (e) => {
        const el = e.target as HTMLElement;
        if (e.metaKey || e.ctrlKey || e.altKey || /input|textarea|select/i.test(el.tagName) || el.isContentEditable) return;
        if (e.key === 'j') go(1);
        else if (e.key === 'k') go(-1);
        else if (e.key === 't') flip();
        else if (e.key === 'p') dispatchEvent(new Event('networkpause'));
        else if (/^[1-9]$/.test(e.key)) document.querySelector<HTMLAnchorElement>(`.bar nav a[data-key="${e.key}"]`)?.click();
      });
    </script>

    <style>
      .bar {
        position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 24px;
        height: 40px; padding: 0 clamp(16px, 4vw, 40px);
        font: 400 12.5px/1 var(--mono); color: var(--dim);
        background: var(--glass); backdrop-filter: blur(var(--blur)) saturate(1.2); -webkit-backdrop-filter: blur(var(--blur)) saturate(1.2);
        border-bottom: 1px solid var(--edge);
      }
      .who { color: var(--ink); font-weight: 500; display: flex; align-items: center; gap: 8px; white-space: nowrap; text-decoration: none; flex-shrink: 0; }
      .blk { display: inline-block; width: .6em; height: 1.05em; background: var(--red); animation: blink 1.1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }
      nav { display: flex; gap: 18px; overflow-x: auto; scrollbar-width: none; min-width: 0; }
      nav::-webkit-scrollbar { display: none; }
      nav a { text-decoration: none; white-space: nowrap; padding: 8px 0; }
      nav b { color: var(--faint); font-weight: 400; }
      nav a:hover { color: var(--ink); }
      nav a:hover b { color: var(--red); }
      .sp { flex: 1; }
      .theme { all: unset; cursor: pointer; white-space: nowrap; flex-shrink: 0; padding: 8px 0; }
      .theme:hover { color: var(--ink); }
      .theme:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
      @media (max-width: 760px) {
        .bar { gap: 14px; }
        .path, .sp { display: none; }
      }
      @media (max-width: 480px) { .theme-label, nav b { display: none; } nav { gap: 14px; } }

      .sl {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; height: 26px; display: flex; align-items: stretch;
        font: 400 11.5px/26px var(--mono); color: var(--dim); white-space: nowrap; overflow: hidden;
        background: var(--glass-hi); backdrop-filter: blur(var(--blur)); -webkit-backdrop-filter: blur(var(--blur));
        border-top: 1px solid var(--edge);
      }
      .sl > span { padding: 0 12px; border-right: 1px solid var(--edge); }
      .sl > span:empty { display: none; }
      .sl .mode { background: var(--ink); color: var(--bg); font-weight: 600; min-width: 64px; text-align: center; }
      .sl > span.sp { flex: 1; border: 0; padding: 0; display: block; }
      .sl .k { color: var(--ink); }
      @media (max-width: 760px) { .sl .wide { display: none; } }
      @media (prefers-reduced-motion: reduce) { .blk { animation: none; } }
    </style>
  </body>
</html>
