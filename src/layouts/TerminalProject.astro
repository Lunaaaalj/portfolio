---
// Featured project page in the terminal world: README window (title block, title, abstract), the
// project's full-bleed figures (slot "figures"), its windows (default slot), the links, and the
// previous and next sheets. The network behind the page reads every [data-feed] window.
import Terminal from './Terminal.astro';
import { person, featured } from '../data/site';

interface Section { id: string; label: string }
interface Props { slug: string; abstract: string; sections: Section[] }
const { slug, abstract, sections } = Astro.props;
const index = featured.findIndex((f) => f.page === `/${slug}`);
const entry = featured[index];
const prev = featured[(index + featured.length - 1) % featured.length];
const next = featured[(index + 1) % featured.length];
const no = (f: typeof entry) => String(featured.indexOf(f) + 1).padStart(2, '0');
const live = (l: { label: string }) => /live|viewer|site/i.test(l.label);
const [coordN, coordW] = entry.sheetInfo.coords;
---
<Terminal title={`${entry.title} · ${person.name}`} description={abstract} sections={sections} path={`~/portfolio/work/${slug}`} home="/" preloadMath>
  <main>
    <div class="col top">
      <section class="win" id="readme" data-feed="readme" aria-labelledby="readme-h">
        <div class="win-bar"><span>cat</span><span class="t">{slug}/README.md</span><span class="rule"></span><span class="reading">reading</span><span class="opt">{coordN} {coordW}</span></div>
        <div class="win-body">
          <p class="prompt" aria-hidden="true">~/portfolio/work $ <span class="cmd">cat {slug}/README.md</span></p>
          <h1 id="readme-h"><span style={`view-transition-name: title-${entry.figure}`}>{entry.title}</span></h1>
          <p class="abstract">{abstract}</p>
          <dl class="kv">
            <div><dt>{(entry.sheetInfo.partnerLabel ?? 'partner').toLowerCase()}</dt><dd>{entry.sheetInfo.partner}</dd></div>
            <div><dt>place</dt><dd>{entry.sheetInfo.place.join(', ')}</dd></div>
            {entry.cells.filter((c) => !/partner|place/i.test(c.label)).map((c) => <div><dt>{c.label.toLowerCase()}</dt><dd>{c.value}</dd></div>)}
            <div><dt>year</dt><dd>{entry.sheetInfo.year}</dd></div>
          </dl>
          <slot name="intro" />
          <p class="keys" aria-hidden="true"><kbd>j</kbd> next window<span class="dot">·</span><kbd>k</kbd> previous<span class="dot">·</span><kbd>1</kbd>–<kbd>{sections.length}</kbd> sections<span class="dot">·</span><kbd>t</kbd> theme<span class="dot">·</span><kbd>p</kbd> pause the network</p>
        </div>
      </section>
    </div>

    <slot name="figures" />

    <div class="col rest">
      <slot />

      <section class="win" id="links" data-feed="links" aria-labelledby="links-h">
        <div class="win-bar"><span>ls</span><span class="t">./links</span><span class="rule"></span><span class="reading">reading</span><span class="opt">{entry.links.length} entries</span></div>
        <div class="win-body">
          <h2 id="links-h" class="vh">Links</h2>
          <ul class="linklist">
            {entry.links.map((l) => (
              <li>
                <a href={l.href}>{live(l) && <span class="live" aria-hidden="true"></span>}{l.label.toLowerCase()} <span class="arrow" aria-hidden="true">↗</span></a>
                {l.note && <span class="s">{l.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <nav class="sheets" aria-label="Featured projects">
        <a href={prev.page} rel="prev"><span>← {no(prev)} previous</span><b>{prev.title}</b></a>
        <a href={next.page} rel="next"><span>{no(next)} next →</span><b>{next.title}</b></a>
      </nav>
    </div>
  </main>

  <footer class="col tfoot">
    <span>-- end of buffer --</span>
    <span>{person.name}, {person.affiliation}</span>
    <a href="/">index ↩</a><a href="#top">back to top ↑</a>
  </footer>
</Terminal>

<style>
  .top { padding-top: 56px; }
  .prompt { font: 400 13px/1 var(--mono); color: var(--dim); margin: 0 0 22px; }
  .cmd { color: var(--ink); }
  h1 { font: 500 clamp(30px, 4.6vw, 54px)/1.02 var(--mono); letter-spacing: -.05em; margin: 0 0 22px; }
  .abstract { font-size: 19px; line-height: 1.5; margin: 0; }
  .keys { font: 400 12.5px/1.9 var(--mono); color: var(--dim); margin: 14px 0 0; }
  .dot { color: var(--faint); padding: 0 .5em; }
  @media (hover: none) { .keys { display: none; } }
  .rest { padding-top: 56px; }

  .linklist { list-style: none; margin: 0; padding: 0; }
  .linklist li { display: grid; grid-template-columns: minmax(0, 240px) minmax(0, 1fr); gap: 4px 18px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--edge); }
  .linklist li:first-child { border-top: 1px solid var(--edge); }
  .linklist a { font: 500 13px/1.3 var(--mono); text-decoration: none; display: inline-flex; gap: 8px; align-items: center; }
  .linklist a:hover { color: var(--red); }
  .linklist .live { width: 7px; height: 7px; background: var(--green); display: inline-block; }
  .s { font: 400 14px/1.45 var(--sans); color: var(--dim); }
  @media (max-width: 640px) { .linklist li { grid-template-columns: 1fr; } }

  .sheets { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 0 0 56px; }
  .sheets a { text-decoration: none; border: 1px solid var(--edge-hi); padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; background: var(--glass); backdrop-filter: blur(var(--blur)); -webkit-backdrop-filter: blur(var(--blur)); }
  .sheets a[rel="next"] { text-align: right; }
  .sheets span { font: 400 11.5px/1 var(--mono); color: var(--dim); }
  .sheets b { font: 500 15px/1.35 var(--sans); }
  .sheets a:hover { background: var(--red); border-color: var(--red); color: var(--bg); }
  .sheets a:hover span { color: var(--bg); }
  @media (max-width: 640px) { .sheets { grid-template-columns: 1fr; } .sheets a[rel="next"] { text-align: left; } }
</style>
