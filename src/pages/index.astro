---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedEntry from '../components/FeaturedEntry.astro';
import MethodsMatrix from '../components/MethodsMatrix.astro';
import FurtherWork from '../components/FurtherWork.astro';
import RunningHead from '../components/RunningHead.astro';
import { person, summary, featured, methods } from '../data/site';
---
<Base title={person.name} description={summary.lead}>
  <Hero />
  <RunningHead title={person.name} after=".hero" />

  <canvas class="bg-canvas" aria-hidden="true"></canvas>

  <main class="page">
    <div class="summary" id="summary">
      <div class="r anchor">
        <div class="m">
          <p class="lead">{summary.lead}</p>
          <p><b>Practice.</b> {summary.practice}</p>
        </div>
        <aside class="note"><p>{summary.plain}</p></aside>
      </div>
      <div class="r">
        <p class="m"><b>Current work.</b> {summary.current}</p>
      </div>
    </div>

    <section id="work" aria-labelledby="work-h">
      <div class="r"><h2 class="m" id="work-h">Selected work</h2></div>
      <ol class="entries">
        {featured.map((entry, i) => <FeaturedEntry entry={entry} sheet={i + 1} of={featured.length} />)}
      </ol>
    </section>

    <section id="methods" aria-labelledby="methods-h">
      <div class="r"><h2 class="m" id="methods-h">Methods by project</h2></div>
      <div class="r"><div class="wide"><MethodsMatrix /></div></div>
      <div class="r">
        <p class="m libs"><b>Libraries.</b> {methods.libraries}<br /><b>Tooling.</b> {methods.tooling}</p>
        <aside class="note">
          <p>Each column is a project and each row a method. The first three columns are the featured projects above.<span class="scroll-hint"> The table scrolls sideways.</span></p>
        </aside>
      </div>
    </section>

    <section id="further" aria-labelledby="further-h">
      <div class="r"><h2 class="m" id="further-h">Further work</h2></div>
      <div class="r"><div class="wide"><FurtherWork /></div></div>
    </section>

    <section id="contact" aria-labelledby="contact-h">
      <div class="r"><h2 class="m" id="contact-h">Contact</h2></div>
      <div class="r">
        <dl class="m contact">
          <div><dt>Email</dt><dd><a href={`mailto:${person.email}`}>{person.email}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={person.linkedin}>angel-eduardo-luna</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={person.github}>Lunaaaalj</a></dd></div>
        </dl>
        <aside class="note colophon">
          <p><b>Colophon.</b> The figures are drawn when the site is built, from each project’s own data: the GeoStats grid, the competition matrix of the reforestation study and the Casa Monarca model specification.</p>
          <p>The background lines are decorative: each curve is the envelope of straight lines (astroid, parabola, cardioid to nephroid, deltoid, circle). Set in STIX Two and IBM Plex.</p>
        </aside>
      </div>
    </section>

    <footer>
      <span>{person.name}, {person.affiliation}</span>
      <a href="#top">Back to top</a>
    </footer>
  </main>
</Base>

<script>
  import { mountEnvelopes } from '../scripts/envelopes';

  mountEnvelopes(
    document.querySelector<HTMLCanvasElement>('.bg-canvas')!,
    [
      { selector: '#summary', kind: 'astroid' },
      { selector: '#work', kind: 'parabola' },
      { selector: '#methods', kind: 'times', m0: 2, m1: 3 },
      { selector: '#further', kind: 'times', m0: -2, m1: -2, spin: Math.PI / 3 },
      { selector: '#contact', kind: 'circle' },
    ],
    document.querySelector<HTMLElement>('.anchor > .note')!, // right edge of the margin column
  );
</script>

<style>
  .bg-canvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .entries { list-style: none; margin: 0; padding: 0; }
  .libs { margin-top: 20px; font: 400 14px/1.6 var(--sans); color: var(--graphite); }
  .libs b { color: var(--ink); font-weight: 500; }
  .scroll-hint { display: none; }
  .contact { margin: 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 12px 40px; }
  .contact dt { font: 400 14px/1.45 var(--sans); color: var(--graphite); }
  .contact dd { margin: 2px 0 0; font-size: 21px; line-height: 1.35; }
  .colophon b { color: var(--ink); font-weight: 500; }
  footer { display: flex; justify-content: space-between; gap: 24px; }
  footer a { color: var(--graphite); }
  @media (max-width: 760px) {
    .contact { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .scroll-hint { display: inline; }
  }
</style>
