  .skip { margin: 0; font: 400 14px/1.45 var(--sans); color: var(--graphite); }
  .showcase { margin-top: 48px; border-bottom: 1px solid var(--rule); }
  .act { margin: 0; padding: 56px 0 18px; font: 400 14px/1.45 var(--sans); color: var(--graphite); }
  .act span { display: inline-block; min-width: 2em; font-variant-numeric: lining-nums; color: var(--ink); }
  .after-table { margin-top: 28px; }
